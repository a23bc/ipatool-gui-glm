{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Capabilities for the main window of ipatool-gui. The shell plugin's scope (which commands can be spawned) lives HERE in Tauri 2, not in tauri.conf.json. We declare the ipatool sidecar as a scoped spawn permission.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "ipatool",
          "cmd": "ipatool",
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "ipatool",
          "cmd": "ipatool",
          "args": true
        }
      ]
    },
    "shell:allow-open",
    "shell:allow-stdin-write",
    "shell:allow-kill",
    "dialog:default",
    "fs:default",
    "process:default",
    "os:default",
    "clipboard-manager:default",
    "notification:default",
    "log:default"
  ]
}
